# EXAMPLE, not installed by default. For the "admin" scope (sudo) with the MINIMUM of rights.
# 1. Remove NoNewPrivileges=true from /etc/systemd/system/door.service, then: systemctl daemon-reload && systemctl restart door
# 2. Copy this file: sudo cp install/sudoers.example /etc/sudoers.d/door && sudo chmod 440 /etc/sudoers.d/door
# 3. Validate it: sudo visudo -cf /etc/sudoers.d/door   (a mistake here can lock you out of sudo: keep a root session open)
# Adapt the list to what you accept the agent doing. Avoid wildcards (*), shells (bash, sh, su) and editors.
# Exact arguments, no wildcards: the agent can only run these commands, exactly as written.
door-agent ALL=(root) NOPASSWD: /usr/bin/systemctl status nginx, /usr/bin/systemctl reload nginx, /usr/sbin/nginx -t, /usr/bin/journalctl -u nginx --no-pager -n 50
